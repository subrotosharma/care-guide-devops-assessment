# Copy to .env and adjust. Never commit the real .env.

# --- application ---
APP_PORT=8080
LOG_LEVEL=INFO
APP_ENV=local
APP_VERSION=0.1.0
# Set to true only to demo the error-rate alert (adds GET /fault that returns 500)
ENABLE_FAULT_INJECTION=false

# --- image used by docker compose ---
IMAGE=devops-task
IMAGE_TAG=local

# --- monitoring stack (docker-compose.monitoring.yml) ---
# Required: compose refuses to start Grafana without them.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me-before-use
# Host port for Grafana (bound to 127.0.0.1 only)
GRAFANA_PORT=3000
# Group id of /var/run/docker.sock, needed by Alloy: stat -c %g /var/run/docker.sock
DOCKER_GID=999
